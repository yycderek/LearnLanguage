{
  "name": "learn-language",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:verify": "node scripts/verify-release.mjs",
    "client:smoke": "node apps/headless/src/main.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm client:smoke && pnpm mobile:check && pnpm release:verify",
    "mobile:check": "pnpm --dir apps/mobile typecheck && pnpm --dir apps/mobile test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@learn-language/application": "workspace:*",
    "@learn-language/engine": "workspace:*",
    "@learn-language/protocol": "workspace:*",
    "ajv": "^8.20.0"
  }
}
